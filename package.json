{
  "name": "2048",
  "version": "1.0.0",
  "description": "\"2048\" - пет проект для практики JS, вдохновленный популярной игрой 2048, написанной итальянским разработчиком Габриэле Чирулли.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo": "node scripts/record-demo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julfy-bs/2048.git"
  },
  "keywords": [
    "game",
    "js"
  ],
  "author": {
    "name": "Bogdan Sutuzhko",
    "email": "julfy.web@gmail.com"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/julfy-bs/2048/issues"
  },
  "homepage": "https://github.com/julfy-bs/2048#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
